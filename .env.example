# ==============================================================================
# CampusOne Root Environment Configuration Example
# Copy to backend/.env and frontend/.env.local respectively for local deployment.
# ==============================================================================

# Backend Gateway Configuration (backend/.env)
PROJECT_NAME="CampusOne"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=campus_one
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/campus_one
JWT_SECRET_KEY=campusone_dev_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GROQ_API_KEY=your_groq_api_key_here  # Optional: for enhanced generative LLM synthesis

# Frontend Web Client Configuration (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
