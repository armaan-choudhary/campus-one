{
  "test_name": "test_format_retrieved_documents",
  "description": "Verify format_retrieved_documents formats correctly with page numbers",
  "input": {
    "sample_docs": [
      {"page_content": "Policy 1 content", "metadata": {"source": "it_policy.pdf", "page": 0}},
      {"page_content": "Policy 2 content", "metadata": {"source": "faq.pdf"}}
    ]
  },
  "expected_output": {
    "contains": [
      "[Retrieved document 1: it_policy.pdf, page 1]",
      "Policy 1 content",
      "[Retrieved document 2: faq.pdf]",
      "Policy 2 content"
    ]
  }
}